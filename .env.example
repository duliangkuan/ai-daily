# 复制为 .env.local（本地开发）并填入真实值；线上同样的键填到 Vercel 环境变量。
# .env.local 已被 .gitignore 忽略，不会进仓库。

# Neon Postgres 连接串（neon.tech 免费）
# 形如：postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ───────────────────────────────────────────────
